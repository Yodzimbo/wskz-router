# Optional: copy to .env to override the defaults built into docker-compose.yml.
# Model pulled by ollama-init and used by the API (full name with tag).
OLLAMA_MODEL=qwen3:4b-instruct
MAIL_FROM=router@example.com
AGENT_TIMEOUT_S=60
# Extra attempts the model gets when it answers with text or invalid tool arguments.
AGENT_RETRIES=3
